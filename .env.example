# Hephaestus backend (api/hephaestus.js) — set these in the Vercel project's
# Environment Variables (Settings → Environment Variables), NOT in the repo.
# For local `vercel dev`, copy this to .env.local (git-ignored) and fill it in.

# Google AI Studio (Gemini) API key — format "AIza…". Get one at
# https://aistudio.google.com/apikey . The free tier needs no billing.
GEMINI_API_KEY=

# Optional model override. Default: gemini-3.5-flash-lite.
# (gemini-2.5-flash-lite was the default until 2026-08-24, when it began
# returning 404 "no longer available to new users".) Live free-tier rate limits
# are shown in AI Studio; Google no longer publishes static per-model numbers.
# GEMINI_MODEL=gemini-3.5-flash-lite
