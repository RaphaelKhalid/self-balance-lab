{
  "name": "selfbalance-lab",
  "version": "1.0.0",
  "description": "SelfBalance — an AI invention studio for kids ages 10–14. Build and remix 3D electronic inventions with real DC circuits, motor physics, and a tool-calling assistant.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:mcp": "node --test mcp/tools.test.mjs",
    "lint": "eslint .",
    "serve": "node tests/server.mjs .",
    "mcp:dev": "mcp-use dev --entry mcp/server.js",
    "mcp:start": "node mcp/server.js",
    "mcp:deploy": "mcp-use deploy --start-command \"node mcp/server.js\"",
    "bench": "node bench/run.mjs",
    "bench:verify": "node bench/verify-tasks.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaphaelKhalid/self-balance-lab.git"
  },
  "keywords": [
    "invention-studio",
    "electronics",
    "circuit-simulator",
    "threejs",
    "rapier",
    "educational",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/RaphaelKhalid/self-balance-lab/issues"
  },
  "homepage": "https://selfbalance-lab.vercel.app/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.6.0",
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "mcp-use": "^1.34.5",
    "zod": "^4.4.3"
  }
}
